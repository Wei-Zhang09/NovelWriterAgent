{
  "name": "novelwriter-agent",
  "version": "0.1.0",
  "private": true,
  "description": "本地优先的 AI 长篇小说创作 Agent（Novel Harness + Story Memory + Novel Distillation Engine）",
  "license": "MIT",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @nwa/desktop dev",
    "build": "pnpm -r build",
    "typecheck": "tsc -b --force --pretty",
    "typecheck:clean": "tsc -b --clean && tsc -b --force --pretty",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run tests/e2e",
    "verify:smoke": "node scripts/run-smoke.mjs",
    "verify:gui": "node scripts/run-gui.mjs",
    "perf": "node scripts/perf-baseline.mjs 1000",
    "check:boundary": "node scripts/check-boundaries.mjs",
    "check:storage": "node scripts/check-storage-exec.mjs",
    "check:gates": "node scripts/self-test-gates.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm check:gates && pnpm check:boundary && pnpm check:storage && pnpm check:verify && pnpm test",
    "verify": "pnpm check && pnpm verify:smoke && pnpm verify:gui && pnpm verify:flow && pnpm verify:model && pnpm verify:simulate",
    "clean": "pnpm -r exec node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build:packages": "pnpm -r --filter \"!@nwa/desktop\" build",
    "verify:flow": "node apps/desktop/scripts/verify-gui-flow.mjs",
    "verify:model": "node scripts/run-model-e2e.mjs",
    "verify:all": "pnpm check && pnpm verify:smoke && pnpm verify:gui && pnpm verify:flow && pnpm verify:model && pnpm verify:simulate && pnpm verify:standalone",
    "typecheck:incremental": "tsc -b --pretty",
    "verify:simulate": "tsx scripts/simulate-chapters.ts --count=20",
    "verify:writing": "electron apps/desktop/scripts/verify-writing-e2e.mjs",
    "verify:plan": "electron apps/desktop/scripts/verify-plan-e2e.mjs",
    "verify:multibook": "electron apps/desktop/scripts/verify-multibook.mjs",
    "verify:corpus": "node scripts/verify-corpus.mjs",
    "verify:books": "node scripts/verify-books.mjs",
    "verify:annotate": "electron apps/desktop/scripts/verify-annotate.mjs",
    "verify:endpoint": "electron apps/desktop/scripts/verify-endpoint.mjs",
    "verify:persist": "electron apps/desktop/scripts/verify-persist.mjs",
    "verify:mine": "electron apps/desktop/scripts/verify-mine.mjs",
    "verify:skill": "electron apps/desktop/scripts/verify-skill.mjs",
    "verify:prune": "electron apps/desktop/scripts/verify-prune.mjs",
    "verify:skill-runtime": "electron apps/desktop/scripts/verify-skill-runtime.mjs",
    "verify:skill-writer": "electron apps/desktop/scripts/verify-skill-writer.mjs",
    "verify:backup": "electron apps/desktop/scripts/verify-backup.mjs",
    "verify:corpus-import": "electron apps/desktop/scripts/verify-corpus-import.mjs",
    "verify:workflow": "electron apps/desktop/scripts/verify-workflow.mjs",
    "verify:retrieval": "electron apps/desktop/scripts/verify-retrieval.mjs",
    "verify:state": "electron apps/desktop/scripts/verify-state.mjs",
    "verify:timeline": "electron apps/desktop/scripts/verify-timeline.mjs",
    "verify:summary-gate": "electron apps/desktop/scripts/verify-summary-gate.mjs",
    "verify:workflow-panel": "node apps/desktop/scripts/verify-workflow-panel.mjs",
    "verify:manuscript-editor": "node apps/desktop/scripts/verify-manuscript-editor.mjs",
    "verify:autosave-scheduler": "node apps/desktop/scripts/verify-autosave-scheduler.mjs",
    "verify:standalone": "node scripts/run-verify-standalone.mjs",
    "check:verify": "node scripts/check-verify-coverage.mjs",
    "verify:chain": "electron apps/desktop/scripts/verify-full-chain.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "electron": "^44.4.3",
    "eslint": "^9.17.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vite": "^7.3.6",
    "vitest": "^5.0.1",
    "zod": "^3.24.1"
  }
}
